{
  "name": "@mdbase-writer/app",
  "version": "0.1.0-beta.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/write-pwa-icons.mjs",
    "i18n:extract": "mdbase-i18n extract",
    "i18n:compile": "mdbase-i18n compile",
    "i18n:source": "mdbase-i18n source",
    "i18n:check": "mdbase-i18n check --compose 'node_modules/@mdbase-dev/ui/dist/locales/{locale}/messages.json'",
    "build": "pnpm i18n:check && pnpm manifest && pnpm manifest:validate && vite build",
    "build:lab": "MDBASE_WRITER_ORIGIN=https://lab.mdbase-writer.pages.dev VITE_MDBASE_ENV=lab pnpm build",
    "build:feedback-test": "VITE_WRITER_DEMO=1 MDBASE_WRITER_ORIGIN=https://lab.mdbase-writer.pages.dev VITE_MDBASE_ENV=lab VITE_MDBASE_FEEDBACK_URL=http://127.0.0.1:8892/v1/feedback pnpm build",
    "build:editing-test": "VITE_WRITER_DEMO=1 pnpm build",
    "dev": "pnpm manifest && vite --host 127.0.0.1",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:validate": "node scripts/validate-manifest.mjs public/.well-known/mdbase-app.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm manifest && node --test scripts/*.test.mjs && vitest run",
    "test:browser:i18n": "node scripts/i18n-browser-test.mjs",
    "test:browser:a11y": "node scripts/browser-a11y-test.mjs",
    "test:browser": "node scripts/browser-test.mjs && node scripts/browser-reliability-test.mjs",
    "test:feedback": "node scripts/feedback-browser-test.mjs",
    "test:browser:reliability": "node scripts/browser-reliability-test.mjs",
    "test:browser:editing": "node scripts/browser-editing-test.mjs",
    "typecheck": "pnpm manifest && tsc -p tsconfig.json",
    "deploy:lab": "MDBASE_ENV=lab node scripts/deploy-pages.mjs",
    "deploy:staging": "MDBASE_ENV=staging node scripts/deploy-pages.mjs",
    "deploy:prod": "MDBASE_ENV=production node scripts/deploy-pages.mjs",
    "upload:compiler": "node scripts/upload-compiler.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.4.3",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.129-c280cd194ffd.tgz",
    "@mdbase-dev/i18n": "0.1.0-beta.148",
    "@mdbase-dev/sdk": "file:../../vendor/sdk-eaa4e697-production-beta141.tgz",
    "@mdbase-dev/ui": "0.1.0-beta.148",
    "@mdbase-writer/core": "workspace:*",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "pandoc-wasm": "1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@callumalpass/mdbase": "0.3.0-rc.5",
    "@lingui/cli": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/vite-plugin": "6.9.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "4.14.0",
    "babel-plugin-macros": "3.1.0",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "vite": "^8.3.1",
    "yaml": "^2.9.0"
  }
}
