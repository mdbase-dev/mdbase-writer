{
  "name": "mdbase-writer",
  "version": "0.1.0-beta.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:production": "VITE_MDBASE_ENV=production VITE_MDBASE_EDITOR_URL=https://editor.mdbase.dev pnpm build",
    "build:publisher-compat": "pnpm build && node scripts/native-tool-compat.mjs",
    "check": "pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @mdbase-writer/app dev",
    "test": "pnpm -r --if-present test && node --test tests/*.test.mjs",
    "test:publisher": "node --test apps/writer/scripts/native-publisher.test.mjs tests/*.test.mjs",
    "test:publisher:ci-unit": "node scripts/test-writer-ci-unit.mjs publisher",
    "test:transport-evidence": "node scripts/qualify-native-staging.mjs originals && node --test tests/writer-failure-evidence.test.mjs",
    "check:ci-unit": "node scripts/test-writer-ci-unit.mjs check",
    "test:publisher:tools": "node scripts/native-tool-compat.mjs",
    "test:staging:intake": "node --test tests/writer-staging-intake.test.mjs",
    "test:installer": "node --test tests/writer-installer.test.mjs",
    "check:staging": "node scripts/qualify-native-staging.mjs check",
    "build:staging:qualification": "node scripts/qualify-native-staging.mjs build",
    "verify:staging:build": "node scripts/qualify-native-staging.mjs verify",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
