{
  "name": "mdbase-writer",
  "version": "0.1.0-beta.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12 <23 || >=24.15 <25"
  },
  "scripts": {
    "check:release-downloads": "node scripts/check-release-downloads.mjs",
    "test:release-downloads": "node --test scripts/check-release-downloads.test.mjs",
    "build": "pnpm -r --if-present build",
    "build:production": "VITE_MDBASE_ENV=production VITE_MDBASE_EDITOR_URL=https://editor.mdbase.dev pnpm build",
    "check": "pnpm i18n:check && pnpm typecheck && pnpm test",
    "i18n:extract": "pnpm --filter @mdbase-writer/app i18n:extract",
    "i18n:compile": "pnpm --filter @mdbase-writer/app i18n:compile",
    "i18n:check": "pnpm --filter @mdbase-writer/app i18n:check",
    "dev": "pnpm --filter @mdbase-writer/app dev",
    "test": "pnpm -r --if-present test && node --test tests/*.test.mjs scripts/publisher/*.test.mjs",
    "test:publisher:build": "node scripts/publisher/rehearsal.mjs",
    "test:publisher": "node --test scripts/publisher/*.test.mjs tests/writer-hosting-policy.test.mjs tests/native-publish-bytes.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
